# ORIÓN — root environment configuration (backend / Digital Twin API)
# Copy this file to .env and adjust values as needed. Never commit a real .env.
#
# The Mission Control UI has its own configuration: see orion-ui/.env.example.

# Application
APP_NAME=ORION Swarm Mission Planner
APP_ENV=development
LOG_LEVEL=INFO

# Digital Twin API server (python -m backend.run)
TWIN_API_HOST=0.0.0.0
TWIN_API_PORT=8000

# Digital Twin runtime
# TWIN_AUTOSTART=1 starts the standing demonstration mission on boot.
TWIN_AUTOSTART=1
TWIN_TICK_INTERVAL_S=0.5

# Mission Definition Pipeline persistence (SQLite, via the replaceable
# DefinitionStore abstraction) and uploaded field imagery.
ORION_DEFINITION_DB=data/mission_pipeline.db
ORION_FIELD_IMAGE_DIR=data/field_images
